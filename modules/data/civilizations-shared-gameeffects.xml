			<Requirement type="REQUIREMENT_CITY_HAS_PROJECT">
				<Argument name="ProjectType">PROJECT_TOWN_GRANARY</Argument>
			</Requirement>
		</SubjectRequirements>
		<Argument name="ModifierId">ATTACH_MOD_GERMANIA_JEC_FOOD_BUILDINGS_FROM_PROJECT</Argument>
	</Modifier>

	<Modifier id="MOD_JEC_FUROR_TEUTONICUS_FISHING_FOOD_BUILDINGS_FROM_PROJECT" collection="COLLECTION_PLAYER_CITIES" effect="EFFECT_ATTACH_MODIFIERS" permanent="true">
		<SubjectRequirements>
			<Requirement type="REQUIREMENT_CITY_HAS_PROJECT">
				<Argument name="ProjectType">PROJECT_TOWN_FISHING</Argument>
			</Requirement>
		</SubjectRequirements>
		<Argument name="ModifierId">ATTACH_MOD_GERMANIA_JEC_FOOD_BUILDINGS_FROM_PROJECT</Argument>
	</Modifier>

	<Modifier id="ATTACH_MOD_GERMANIA_JEC_FOOD_BUILDINGS_FROM_PROJECT" collection="COLLECTION_OWNER" effect="EFFECT_ADJUST_TOWN_CAN_PURCHASE_TAGGED_CONSTRUCTIBLES">
