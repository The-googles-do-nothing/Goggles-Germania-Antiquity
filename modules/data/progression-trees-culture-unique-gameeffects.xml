	<!-- CODANUS -->
	<Modifier id="MOD_JEC_GERMANIA_NAVAL_WATER" collection="COLLECTION_PLAYER_CITIES" effect="EFFECT_CITY_GRANT_UNIT" permanent="true">
		<SubjectRequirements>
			<Requirement type="REQUIREMENT_CITY_BUILT_TAGGED_CONSTRUCTIBLE">
				<Argument name="Tags">WATER</Argument>
			</Requirement>
		</SubjectRequirements>
		<Argument name="AllowUniqueOverride">true</Argument>
		<Argument name="UnitTag">UNIT_CLASS_NAVAL</Argument>
		<Argument name="Amount">1</Argument>
		<String context="Description">LOC_MOD_JEC_GERMANIA_NAVAL_WATER_DESCRIPTION</String>
	</Modifier>
	<!-- BARBARICUM -->
	<!-- Level 1 -->
