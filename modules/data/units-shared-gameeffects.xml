<?xml version="1.0" encoding="utf-8"?>
<GameEffects xmlns="GameEffects">
	<!-- army -->
	<Modifier id="MOD_KUNINGAZ_ADJUST_RESPAWN_SPEED" collection="COLLECTION_OWNER" effect="EFFECT_ARMY_ADJUST_RESPAWN_SPEED">
		<Argument name="Percent">-50</Argument>
	</Modifier>

	<!-- greatperson -->
	<!--Unit Abilities-->
	<Modifier id="MOD_GERMANIA_MOVEMENT_JEC" collection="COLLECTION_OWNER" effect="EFFECT_UNIT_ADJUST_MOVEMENT">
		<Argument name="Amount">1</Argument>
		<String context="Preview">LOC_ABILITY_GERMANIA_MOVEMENT_JEC_PREVIEW</String>
	</Modifier>
	<Modifier id="MOD_GERMANIA_EMBARKED_MOVEMENT_JEC" collection="COLLECTION_OWNER" effect="EFFECT_ADJUST_UNIT_EMBARKED_MOVEMENT">
		<Argument name="Amount">1</Argument>
		<String context="Preview">LOC_ABILITY_GERMANIA_EMBARKED_MOVEMENT_JEC_PREVIEW</String>
	</Modifier>
	<Modifier id="MOD_GERMANIA_COMBAT_STRENGTH_JEC" collection="COLLECTION_UNIT_COMBAT" effect="EFFECT_ADJUST_UNIT_STRENGTH_MODIFIER">
		<Argument name="Amount">3</Argument>
		<String context="Preview">LOC_ABILITY_GERMANIA_COMBAT_STRENGTH_JEC_PREVIEW</String>
	</Modifier>

	<Modifier id="MOD_GERMANIA_COMBAT_STRENGTH_ATTACKING_JEC" collection="COLLECTION_UNIT_COMBAT" effect="EFFECT_ADJUST_UNIT_STRENGTH_MODIFIER">
		<SubjectRequirements>
			<Requirement type="REQUIREMENT_PLAYER_IS_ATTACKING"/>
		</SubjectRequirements>
		<Argument name="Amount">3</Argument>
		<String context="Preview">LOC_ABILITY_GERMANIA_COMBAT_STRENGTH_ATTACKING_JEC_PREVIEW</String>
	</Modifier>

	<Modifier id="MOD_GERMANIA_COMBAT_STRENGTH_VS_CAVALRY_JEC" collection="COLLECTION_UNIT_COMBAT" effect="EFFECT_ADJUST_UNIT_STRENGTH_MODIFIER">
		<SubjectRequirements>
			<Requirement type="REQUIREMENT_OPPONENT_UNIT_TAG_MATCHES">
				<Argument name="Tag">UNIT_CLASS_CAVALRY</Argument>
			</Requirement>
		</SubjectRequirements>
		<Argument name="Amount">5</Argument>
		<String context="Preview">LOC_ABILITY_GERMANIA_COMBAT_STRENGTH_VS_CAVALRY_JEC_PREVIEW</String>
	</Modifier>

	<Modifier id="MOD_GERMANIA_COMBAT_STRENGTH_BIOME_JEC" collection="COLLECTION_UNIT_COMBAT" effect="EFFECT_ADJUST_UNIT_STRENGTH_MODIFIER">
		<Argument name="Amount">3</Argument>
		<String context="Preview">LOC_ABILITY_GERMANIA_COMBAT_STRENGTH_BIOME_JEC_PREVIEW</String>
	</Modifier>

	<Modifier id="MOD_GERMANIA_GOLD_ON_UNIT_DEFEAT_JEC" collection="COLLECTION_PLAYER_COMBAT" effect="EFFECT_ADJUST_UNIT_POST_COMBAT_YIELD">
		<Argument name="YieldType">YIELD_GOLD</Argument>
		<Argument name="PercentDefeatedStrength">50</Argument>
		<String context="Preview">LOC_ABILITY_GERMANIA_GOLD_ON_UNIT_DEFEAT_JEC_PREVIEW</String>
	</Modifier>

	<Modifier id="MOD_GERMANIA_JEC_RESTORE_MOVEMENT_VEGETATED_JEC" collection="COLLECTION_OWNER" effect="EFFECT_RESTORE_UNIT_MOVEMENT">
		<SubjectRequirements>
			<Requirement type="REQUIREMENT_PLOT_FEATURE_TYPE_MATCHES">
				<Argument name="FeatureClassType">FEATURE_CLASS_VEGETATED</Argument>
			</Requirement>
		</SubjectRequirements>
		<Argument name="MovementOnly">true</Argument>
		<Argument name="RestoreAfterMoving">true</Argument>
	</Modifier>

</GameEffects>
