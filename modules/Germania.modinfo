<?xml version="1.0" encoding="utf-8"?>
<Mod id="goggles_civ_germania" version="1"
	xmlns="ModInfo">
	<!-- Atributions: 
	Icons Images Provided by:
	Vathareon
	Haselgebrige Salt Mine Quote From:
	https://www.sciencedirect.com/science/article/pii/S0191814111000423

	-->
	<Properties>
		<Name>LOC_MODULE_GERMANIA_NAME</Name>
		<Description>LOC_MODULE_GERMANIA_DESCRIPTION</Description>
		<Authors>LOC_AUTHORS_JEC</Authors>
		<Package>DLC</Package>
	</Properties>
	<Dependencies>
		<Mod id="base-standard" title="LOC_MODULE_BASE_STANDARD_NAME"/>
	</Dependencies>
	<ActionCriteria>
		<Criteria id="antiquity-age-current">
			<AgeInUse>AGE_ANTIQUITY</AgeInUse>
		</Criteria>
		<Criteria id="antiquity-age-persist" any="true">
			<AgeInUse>AGE_ANTIQUITY</AgeInUse>
			<AgeInUse>AGE_EXPLORATION</AgeInUse>
			<AgeInUse>AGE_MODERN</AgeInUse>
		</Criteria>
		<Criteria id="exploration-age-current">
			<AgeInUse>AGE_EXPLORATION</AgeInUse>
		</Criteria>
		<Criteria id="exploration-age-persist" any="true">
			<AgeInUse>AGE_EXPLORATION</AgeInUse>
			<AgeInUse>AGE_MODERN</AgeInUse>
		</Criteria>
		<Criteria id="modern-age-current">
			<AgeInUse>AGE_MODERN</AgeInUse>
		</Criteria>
		<Criteria id="modern-age-persist" any="true">
			<AgeInUse>AGE_MODERN</AgeInUse>
		</Criteria>
		<Criteria id="always">
			<AlwaysMet></AlwaysMet>
		</Criteria>
        <Criteria all="true" id="ged-ynamp-enable">
            <ModInUse>ged-ynamp</ModInUse>
        </Criteria>
        <Criteria all="true" id="izica-unit-portrait-visual-remaps-enable">
            <ModInUse>izica-unit-portrait-visual-remaps</ModInUse>
        </Criteria>
        <Criteria all="true" id="friedrich-xerxes-alt-enable">
            <ModInUse>friedrich-xerxes-alt</ModInUse>
        </Criteria>
	</ActionCriteria>
	<ActionGroups>
		<!-- Optional compatability -->
		<ActionGroup id="base-game-friedrich-xerxes-alt" scope="game" criteria="friedrich-xerxes-alt-enable">
			<Actions>
                <UpdateDatabase>
					<Item>friedrich-alt/data/unlocks-friedrich-alt.xml</Item>
                </UpdateDatabase>
                <UpdateText>
                </UpdateText>
            </Actions>
		</ActionGroup>
		<ActionGroup id="base-game-main-ged-ynamp" scope="game" criteria="ged-ynamp-enable">
			<!-- ynamp compatability -->
			<Actions>
                <UpdateDatabase>
					<Item>ynamp/data/greatest-earth.xml</Item>
                </UpdateDatabase>
            </Actions>
		</ActionGroup>
		<ActionGroup id="izica-unit-portrait-visual-remaps" scope="game" criteria="izica-unit-portrait-visual-remaps-enable">
			<Actions>
				<UIScripts>
					<Item>ui/game.js</Item>
				</UIScripts>
			</Actions>
		</ActionGroup>
		<!-- Germania -->
		<!-- Age specific updates -->
		<ActionGroup id="swiss-confederacy-text" scope="game" criteria="always">
			<Actions>	
                <UpdateText>
					<Item>text/en_us/CitizenNamesText.xml</Item>
					<Item>text/en_us/CityNamesText.xml</Item>
					<Item>text/en_us/CivilizationText.xml</Item>
					<Item>text/en_us/ConstructibleText.xml</Item>
					<Item>text/en_us/CultureText.xml</Item>
					<Item>text/en_us/CultureToTText.xml</Item>
					<Item>text/en_us/GreatPeopleText.xml</Item>
					<Item>text/en_us/LoadingText.xml</Item>
					<Item>text/en_us/ModuleText.xml</Item>
					<Item>text/en_us/NarrativeStoriesText.xml</Item>
					<Item>text/en_us/ResourcesText.xml</Item>
					<Item>text/en_us/UnitSharedText.xml</Item>	
					<Item>text/en_us/UnitText.xml</Item>	
					<Item>text/en_us/UnitExplorationText.xml</Item>
					<Item>text/en_us/UnitPromotionsText.xml</Item>
					<Item>text/en_us/UnlockText.xml</Item>
					<Item>text/en_us/WonderText.xml</Item>
                </UpdateText>
            </Actions>
        </ActionGroup>
        <ActionGroup id="base-game-main-Germania" scope="game" criteria="always">
            <Actions>
                <UpdateDatabase>
					<Item>data/civilizations-shared.xml</Item>
					<Item>data/civilizations-shared-gameeffects.xml</Item>
					<Item>data/civilizations-legacy.xml</Item>
					<Item>data/constructibles-shared-gameeffects.xml</Item>
					<Item>data/constructibles-shared.xml</Item>
					<Item>data/loading-info.xml</Item>
					<Item>data/requirement-sets.xml</Item>
					<Item>data/traditions.xml</Item>
					<Item>data/traditions-gameeffects.xml</Item>
					<Item>data/unlocks-syncretism.xml</Item>
					<Item>data/unlocks.xml</Item>
					<Item>data/wonders-shared.xml</Item>
					<Item>data/wonders-shared-gameeffects.xml</Item>
					<Item>data/units-shared.xml</Item>
					<Item>data/units-shared-gameeffects.xml</Item>
					<Item>data/unit-promotions-antiquity.xml</Item>
					<Item>data/unit-promotions-antiquity-gameeffects.xml</Item>
                </UpdateDatabase>

                <ImportFiles>
					<Item>icons/bg-panel-germania_jec</Item>
					<Item>icons/bg-panel-germania_jec.png</Item>
					<Item>icons/buildicon_herrenhofe_jec.png</Item>		
					<Item>icons/civ_line_germania_jec.png</Item>
                    <Item>icons/civ_sym_germania_jec</Item>
					<Item>icons/civ_sym_germania_jec.png</Item>
					<Item>icons/cult_germania_jec.png</Item>
					<Item>icons/lsbg_germania_720.png</Item>
                    <Item>icons/lsbg_germania_1080.png</Item>
					<Item>icons/resicon_amber.png</Item>
					<Item>icons/unitflag_folc_jec.png</Item>
					<Item>icons/unitflag_suebi_jec_2.png</Item>
					<Item>icons/unitflag_suebi_jec_3.png</Item>
					<Item>icons/unitflag_suebi_jec.png</Item>
					<Item>icons/unitflag_boar_warrior_jec.png</Item>
					<Item>icons/unitflag_boar_warrior_jec_2.png</Item>
					<Item>icons/unitflag_wolf_warrior_jec.png</Item>
					<Item>icons/unitflag_kuningaz_jec.png</Item>
					<Item>icons/wondericon_haselgebrige_salt_mine.png</Item>
                </ImportFiles>
                <UpdateIcons>
					<Item>data/icons/icons.xml</Item>
                </UpdateIcons>
                <UpdateVisualRemaps>
                    <Item>data/visual-remap.xml</Item>
                </UpdateVisualRemaps>
				<UIScripts>
					<Item>ui/unit-promotion/model-unit-promotion.js</Item>
				</UIScripts>
            </Actions>
        </ActionGroup>

		<ActionGroup id="antiquity-age-current-Germania" scope="game" criteria="antiquity-age-current">
			<Actions>
				<UpdateArt>
				</UpdateArt>
				<UpdateDatabase>
					<Item>data/ai-antiquity.xml</Item>
					<Item>data/citizen-names.xml</Item>
					<Item>data/civilizations-antiquity-gameeffects.xml</Item>
					<Item>data/civilizations-antiquity.xml</Item>

					<Item>data/greatpeople-gameeffects.xml</Item>
					<Item>data/greatpeople.xml</Item>
					
					<Item>data/narrative-stories-gameeffects-antiquity.xml</Item>
					<Item>data/narrative-stories-antiquity.xml</Item>

					<Item>data/progression-trees-culture-common.xml</Item>
					<Item>data/progression-trees-culture-unique-gameeffects.xml</Item>
					<Item>data/progression-trees-culture-unique.xml</Item>

					<Item>data/progression-trees-tech-common.xml</Item>

					<Item>data/units-antiquity.xml</Item>
					<Item>data/units-antiquity-gameeffects.xml</Item>

					<Item>data/resources.xml</Item>
					<Item>data/resources-gameeffects.xml</Item>
				</UpdateDatabase>

			</Actions>
		</ActionGroup>
		<ActionGroup id="age-exploration-main-Germania" scope="game" criteria="exploration-age-current">
			<Actions>
				<UpdateDatabase>
					<Item>data/ai-exploration.xml</Item>
					<Item>data/civilizations-exploration.xml</Item>
					<Item>data/progression-trees-culture-unique-ex.xml</Item>
					<Item>data/age-transition-advanced-start-exploration.xml</Item>
					<Item>data/units-exploration.xml</Item>
					<Item>data/units-exploration-gameeffects.xml</Item>
					<Item>data/progression-trees-tech-common-ex.xml</Item>
				</UpdateDatabase>
			</Actions>
		</ActionGroup>
		<ActionGroup id="age-modern-main-Germania" scope="game" criteria="modern-age-current">
			<Actions>
				<UpdateDatabase>
					<Item>data/civilizations-modern.xml</Item>
					<Item>data/progression-trees-culture-unique-mo.xml</Item>
					<Item>data/age-transition-advanced-start-modern.xml</Item>
				</UpdateDatabase>
			</Actions>
		</ActionGroup>
		<ActionGroup id="shell-germania" scope="shell" criteria="always">
			<Actions>
				<UpdateDatabase>
					<Item>config/config.xml</Item>
					<Item>config/config-traditions.xml</Item>
					<Item>data/unlocks-syncretism.xml</Item>
				</UpdateDatabase>
                <ImportFiles>
					<Item>icons/bg-panel-germania_jec</Item>
					<Item>icons/bg-panel-germania_jec.png</Item>
					<Item>icons/buildicon_herrenhofe_jec.png</Item>		
					<Item>icons/civ_line_germania_jec.png</Item>
                    <Item>icons/civ_sym_germania_jec</Item>
					<Item>icons/civ_sym_germania_jec.png</Item>
					<Item>icons/cult_germania_jec.png</Item>
					<Item>icons/lsbg_germania_720.png</Item>
                    <Item>icons/lsbg_germania_1080.png</Item>
					<Item>icons/resicon_amber.png</Item>
					<Item>icons/unitflag_folc_jec.png</Item>
					<Item>icons/unitflag_suebi_jec_2.png</Item>
					<Item>icons/unitflag_suebi_jec_3.png</Item>
					<Item>icons/unitflag_suebi_jec.png</Item>
					<Item>icons/unitflag_boar_warrior_jec.png</Item>
					<Item>icons/unitflag_boar_warrior_jec_2.png</Item>
					<Item>icons/unitflag_wolf_warrior_jec.png</Item>
					<Item>icons/unitflag_kuningaz_jec.png</Item>
					<Item>icons/wondericon_haselgebrige_salt_mine.png</Item>
                </ImportFiles>
                <UpdateIcons>
                    <Item>data/icons/icons.xml</Item>
                </UpdateIcons>
				<UpdateText>
					<Item>text/en_us/CitizenNamesText.xml</Item>
					 <Item>text/en_us/CityNamesText.xml</Item>
					<Item>text/en_us/CivilizationText.xml</Item>
					<Item>text/en_us/ConstructibleText.xml</Item>
					<Item>text/en_us/CultureText.xml</Item>
					<Item>text/en_us/CultureToTText.xml</Item>
					<Item>text/en_us/GreatPeopleText.xml</Item>
					<Item>text/en_us/LoadingText.xml</Item>
					<Item>text/en_us/ModuleText.xml</Item>
					<Item>text/en_us/NarrativeStoriesText.xml</Item>
					<Item>text/en_us/ResourcesText.xml</Item>
					<Item>text/en_us/UnitSharedText.xml</Item>	
					<Item>text/en_us/UnitText.xml</Item>	
					<Item>text/en_us/UnitExplorationText.xml</Item>	
					<Item>text/en_us/UnitPromotionsText.xml</Item>	
					<Item>text/en_us/UnlockText.xml</Item>
					<Item>text/en_us/WonderText.xml</Item>
				</UpdateText>
                <UpdateVisualRemaps>
                    <Item>data/visual-remap.xml</Item>
                </UpdateVisualRemaps>

			</Actions>
		</ActionGroup>
	</ActionGroups>
	<LocalizedText>
		<File>text/en_us/ModuleText.xml</File>
	</LocalizedText>
</Mod>